# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=nas_ec2
POSTGRES_USER=nas_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NAS API
NAS_API_BASE_URL=http://nas-api:8000
NAS_SERVICE_TOKEN=change-me-shared-secret

# Quarantine
QUARANTINE_DIR=/var/app/quarantine
QUARANTINE_MAX_AGE_HOURS=24

# Upload limits
MAX_UPLOAD_SIZE_BYTES=10737418240
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown,image/jpeg,image/png,image/gif,application/zip,video/mp4
BLOCKED_EXTENSIONS=exe,dll,js,vbs,bat,cmd,ps1,sh,msi,scr
